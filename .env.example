# ==============================================================================
# Environment Configuration
# ==============================================================================

# Flask environment mode: development | production | testing
FLASK_ENV=development

# Server network binding
HOST=0.0.0.0
PORT=5000

# Security: Secret key for cryptographic signing and session tokens
# In production, generate a cryptographically strong 32+ byte hex string:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-insecure-secret-key-change-in-production

# CORS Configuration: Comma-separated list of trusted client origins
# Typical React Native local dev origins:
# - Metro bundler: http://localhost:8081, http://127.0.0.1:8081
# - Expo web: http://localhost:19006, http://localhost:8082
# - Android Emulator loopback alias: http://10.0.2.2:8081
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://localhost:3000

# Database URI (Defaults to SQLite in ./instance/agent.db if left unset)
DATABASE_URL=

# ==============================================================================
# AI / LLM Provider Configuration
# Set either GROQ_API_KEY or OPENAI_API_KEY (or both)
# ==============================================================================

# Groq Cloud (Ultra-fast inference with Llama 3)
# Get a free key at https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI
# Get a key at https://platform.openai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Optional custom system instruction override (defaults to DEFAULT_SYSTEM_PROMPT in agent_service.py)
# AGENT_SYSTEM_PROMPT="You are an elite, executive personal AI assistant. Strictly avoid raw tables; use bold headers, clean bullets, and concise executive summaries."
